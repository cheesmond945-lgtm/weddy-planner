        <mxCell id="s1" value="Kiểm tra hồ sơ NCC đã được duyệt và đã chọn lĩnh vực cung cấp" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="610" y="100" width="220" height="60" as="geometry"/></mxCell>
