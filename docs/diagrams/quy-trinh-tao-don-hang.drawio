        </mxCell>
        <mxCell id="s5" value="Lưu đơn: tạo mã đơn, trạng thái Chờ thanh toán cọc, tính tiền cọc, hạn cọc 12 giờ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
