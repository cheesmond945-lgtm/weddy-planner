<mxfile host="app.diagrams.net">
  <diagram id="tao-don-hang" name="Quy trình tạo đơn hàng">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Khung, tiêu đề và hai làn -->
        <mxCell id="title" value="QUY TRÌNH TẠO ĐƠN HÀNG" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="880" height="40" as="geometry" />
        </mxCell>
        <mxCell id="laneNcc" value="Nhà cung cấp" style="swimlane;startSize=30;html=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="420" height="1100" as="geometry" />
        </mxCell>
        <mxCell id="laneSys" value="Hệ thống" style="swimlane;startSize=30;html=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="440" y="60" width="460" height="1100" as="geometry" />
        </mxCell>

        <!-- Nhà cung cấp -->
        <mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="210" y="110" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="Tại khung chat với khách, chọn Tạo đơn" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="185" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Nhập hạng mục báo giá (chọn sảnh hoặc gắn gói), số lượng, đơn giá, tỷ lệ cọc, ghi chú" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="290" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Chọn Gửi đơn" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="405" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Chọn Vẫn gửi" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="605" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Chọn Gửi đơn" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="745" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Hệ thống -->
        <mxCell id="s1" value="Hiển thị form tạo đơn, điền sẵn tên, số điện thoại của khách và ngày thực hiện = ngày cưới" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="180" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Tự điền dòng báo giá theo sảnh / gói đã chọn (đơn giá, số bàn tối thiểu), tính tổng tiền và tiền cọc" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="290" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Kiểm tra và xác thực thông tin bắt buộc (số điện thoại, ngày thực hiện, hạng mục, tỷ lệ cọc, sảnh còn trống, khách đã có thông tin đám cưới)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="385" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dv1" value="" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="725" y="505" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="err" value="Hiển thị lỗi tại từng trường chưa hợp lệ, yêu cầu nhập lại" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="500" width="180" height="60" as="geometry" />
