        </mxCell>
        <mxCell id="warn" value="Hiển thị cảnh báo đơn chưa gắn gói (khách sẽ không có công việc sau khi cọc)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
