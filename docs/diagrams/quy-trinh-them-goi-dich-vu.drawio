<mxfile host="app.diagrams.net">
  <diagram id="them-goi-dich-vu" name="Quy trình thêm gói dịch vụ">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Khung, tiêu đề và hai làn -->
        <mxCell id="title" value="QUY TRÌNH THÊM GÓI DỊCH VỤ" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="880" height="40" as="geometry" />
        </mxCell>
        <mxCell id="laneNcc" value="Nhà cung cấp" style="swimlane;startSize=30;html=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="420" height="1290" as="geometry" />
        </mxCell>
        <mxCell id="laneSys" value="Hệ thống" style="swimlane;startSize=30;html=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="440" y="60" width="460" height="1290" as="geometry" />
        </mxCell>

        <!-- Nhà cung cấp -->
        <mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="210" y="110" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="Tại màn hình Quản lý gói dịch vụ, chọn Thêm gói dịch vụ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="180" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Nhập thông tin gói (tên, giá, mô tả...) và tải ảnh ở tab Thông tin gói" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="280" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="(Tùy chọn) Mở tab Công việc, thêm / sửa công việc của gói" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="130" y="370" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="noteTasks" value="Công việc không cần Admin duyệt; lưu được bất cứ lúc nào, kể cả khi gói đang chờ duyệt hoặc đã đăng" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="30" y="445" width="175" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Chọn nút Gửi duyệt" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="560" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Chọn Gửi duyệt" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="795" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Hệ thống -->
        <mxCell id="s1" value="Hiển thị trang thêm gói gồm 2 tab: Thông tin gói và Công việc" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="180" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sb1" value="Kiểm tra thông tin bắt buộc: tên, giá, mô tả, ít nhất 1 ảnh, hồ sơ NCC đã được duyệt" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="545" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dv" value="" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="715" y="680" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="err" value="Hiển thị lỗi tại từng trường chưa hợp lệ, yêu cầu nhập lại" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="680" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="popup" value="Hiển thị popup xác nhận gửi duyệt" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="790" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="Lưu thông tin gói, chuyển trạng thái gói = Chờ duyệt" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="900" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="Lưu công việc của gói (nếu có), không gửi duyệt" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="990" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="Gửi thông báo cho Admin: Gói chờ duyệt" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="1080" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="Thông báo đã gửi duyệt thành công. Thông tin gói chỉ đọc khi chờ duyệt, tab Công việc vẫn sửa được" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="1160" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="end" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#ff0000;" vertex="1" parent="1">
          <mxGeometry x="750" y="1280" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="noteLabel" value="Gói chưa có công việc nào: danh sách gói và tab Công việc hiện nhãn &quot;Chưa có công việc&quot;; form đơn của NCC báo &quot;Gói này chưa có công việc nào&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="460" y="1000" width="180" height="110" as="geometry" />
        </mxCell>

