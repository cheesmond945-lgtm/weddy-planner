model commission_statements {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendor_id        String?          @db.Uuid
  period_month     DateTime?        @db.Date
  due_date         DateTime?        @db.Date
  total_orders     Int?             @default(0)
  total_amount     Decimal?         @default(0) @db.Decimal(18, 2)
  transaction_code String?          @unique @db.VarChar(100)
  status           String?          @default("Unpaid") @db.VarChar(20)
  paid_date        DateTime?        @db.Timestamptz(6)
  created_date     DateTime?        @default(now()) @db.Timestamptz(6)
  vendor_profiles  vendor_profiles? @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  commissions      commissions[]

  @@unique([vendor_id, period_month])
  @@index([status, due_date], map: "ix_statements_status_due")
}

