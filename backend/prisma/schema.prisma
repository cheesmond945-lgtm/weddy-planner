  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wedding_id         String?             @db.Uuid
  category_id        String?             @db.Uuid
  order_id           String?             @db.Uuid
  title              String?             @db.VarChar(255)
  scheduled_date     DateTime?           @db.Date
  status             String?             @default("Todo") @db.VarChar(20)
  completed_date     DateTime?           @db.Timestamptz(6)
  task_type          String?             @db.VarChar(20)
  task_code          String?             @db.VarChar(50)
  display_order      Int?                @default(0)
  created_date       DateTime?           @default(now()) @db.Timestamptz(6)
  assignee           String?             @db.VarChar(20)
  assignee_user_id   String?             @db.Uuid
  note               String?             @db.VarChar(200)
  note_by            String?             @db.Uuid
  note_date          DateTime?           @db.Timestamptz(6)
  completed_by       String?             @db.Uuid
  assignee_user      users?              @relation("timeline_tasks_assignee_user", fields: [assignee_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  note_user          users?              @relation("timeline_tasks_note_by", fields: [note_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  completed_user     users?              @relation("timeline_tasks_completed_by", fields: [completed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  service_categories service_categories? @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders             orders?             @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  weddings           weddings?           @relation(fields: [wedding_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
