  @@unique([wedding_id, task_code])
  @@index([order_id], map: "ix_timeline_order")
  @@index([wedding_id, scheduled_date], map: "ix_timeline_wedding_date")
  @@index([assignee_user_id], map: "ix_timeline_assignee_user")
}

