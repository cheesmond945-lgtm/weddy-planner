# Copy file này thành ".env" (cùng thư mục) rồi điền giá trị thật. KHÔNG commit .env lên GitHub.

# Supabase > nút Connect (trên cùng) > tab "ORMs" hoặc "Connection String" > chọn "Session pooler" (cổng 5432)
# Thay [YOUR-PASSWORD] bằng mật khẩu database. Nếu mật khẩu có ký tự đặc biệt (@ # / : ?) thì phải mã hóa URL (vd @ -> %40)
DATABASE_URL="postgresql://postgres.kiomwvtaadqnditkbneo:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

SUPABASE_URL="https://kiomwvtaadqnditkbneo.supabase.co"
# Supabase > Project Settings > API Keys > Secret keys (sb_secret_...). Chỉ dùng ở backend.
SUPABASE_SECRET_KEY="sb_secret_xxx"

# Chuỗi ngẫu nhiên dài, tự đặt (vd chạy: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="doi-thanh-chuoi-ngau-nhien-dai"

PORT=3000
# Địa chỉ frontend được phép gọi API (cách nhau bởi dấu phẩy)
CORS_ORIGIN="http://localhost:5173,http://localhost:3001"
