# Copy file này thành ".env" (cùng thư mục) rồi điền giá trị thật. KHÔNG commit .env lên GitHub.

# Supabase > nút Connect (trên cùng) > tab "ORMs" hoặc "Connection String".
# Thay [YOUR-PASSWORD] bằng mật khẩu database. Nếu mật khẩu có ký tự đặc biệt (@ # / : ?) thì phải mã hóa URL (vd @ -> %40)
# App chạy qua "Transaction pooler" (cổng 6543). KHÔNG dùng cổng 5432 cho app: Session pooler chỉ có 15 kết nối
# cho cả project, vài backend (máy các thành viên + server deploy) cùng chạy là hết, gây lỗi 500 EMAXCONNSESSION.
DATABASE_URL="postgresql://postgres.kiomwvtaadqnditkbneo:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
# Chỉ dùng cho npm run db:pull (cần "Session pooler", cổng 5432)
DIRECT_URL="postgresql://postgres.kiomwvtaadqnditkbneo:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

SUPABASE_URL="https://kiomwvtaadqnditkbneo.supabase.co"
# Supabase > Project Settings > API Keys > Secret keys (sb_secret_...). Chỉ dùng ở backend.
SUPABASE_SECRET_KEY="sb_secret_xxx"

# Chuỗi ngẫu nhiên dài, tự đặt (vd chạy: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="doi-thanh-chuoi-ngau-nhien-dai"

PORT=3000
# Địa chỉ frontend được phép gọi API (cách nhau bởi dấu phẩy)
CORS_ORIGIN="http://localhost:5173,http://localhost:3001"

# Gửi email thông tin tài khoản. Dùng Gmail + "Mật khẩu ứng dụng" (Google Account > Bảo mật > Xác minh 2 bước > Mật khẩu ứng dụng), KHÔNG dùng mật khẩu đăng nhập Gmail.
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=WebPlan
# Địa chỉ frontend dùng cho link đăng nhập trong email (mặc định lấy từ CORS_ORIGIN)
FRONTEND_URL=

# Thanh toán hoa hồng qua VNPay. Bỏ trống hoặc PAYMENT_MODE=simulate: chạy chế độ giả lập (trang VNPay sandbox giả trong frontend).
# Có tài khoản sandbox/merchant: điền TMN Code, Hash Secret rồi đặt PAYMENT_MODE=live.
PAYMENT_MODE=simulate
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Địa chỉ VNPay chuyển về sau khi thanh toán (mặc định: <FRONTEND_URL>/vendor/commissions/vnpay-return)
VNPAY_RETURN_URL=
