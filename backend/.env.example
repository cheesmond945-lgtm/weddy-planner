# Copy file này thành ".env" (cùng thư mục) rồi điền giá trị thật. KHÔNG commit .env lên GitHub.

# Supabase > nút Connect (trên cùng) > tab "ORMs" hoặc "Connection String" > chọn "Session pooler" (cổng 5432)
# Thay [YOUR-PASSWORD] bằng mật khẩu database. Nếu mật khẩu có ký tự đặc biệt (@ # / : ?) thì phải mã hóa URL (vd @ -> %40)
DATABASE_URL="postgresql://postgres.kiomwvtaadqnditkbneo:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

SUPABASE_URL="https://kiomwvtaadqnditkbneo.supabase.co"
# Supabase > Project Settings > API Keys > Secret keys (sb_secret_...). Chỉ dùng ở backend.
SUPABASE_SECRET_KEY="sb_secret_xxx"

# Chuỗi ngẫu nhiên dài, tự đặt (vd chạy: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="doi-thanh-chuoi-ngau-nhien-dai"

PORT=3000
# Địa chỉ frontend được phép gọi API (cách nhau bởi dấu phẩy)
CORS_ORIGIN="http://localhost:5173,http://localhost:3001"

# Google Places API (New): Google Cloud Console > APIs & Services > Credentials. Bật "Places API (New)" và billing.
# Để trống thì API điểm Google trả 503, web hiện "Chưa có điểm Google".
GOOGLE_MAPS_API_KEY=

# Gửi email (OTP đăng ký). Gmail: bật xác minh 2 bước rồi tạo Mật khẩu ứng dụng tại
# https://myaccount.google.com/apppasswords — KHÔNG dùng mật khẩu tài khoản Gmail.
# Để trống MAIL_PASSWORD thì backend chỉ in mã OTP ra terminal.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=your-account@gmail.com
MAIL_PASSWORD=
MAIL_FROM="WebPlan <your-account@gmail.com>"

# --- Đơn hàng và thanh toán cọc ---
# PAYMENT_MODE: simulate = ghi nhận thanh toán cọc thành công ngay (chạy thử, demo); vnpay = VNPay thật (CHƯA tích hợp, trả 501).
# Để trống: giả lập khi chạy dev; nếu NODE_ENV=production thì phải đặt rõ PAYMENT_MODE=simulate mới giả lập được.
PAYMENT_MODE=simulate
# true: quét TOÀN HỆ THỐNG đơn hết hạn cọc / tự hoàn thành, lúc khởi động và mỗi giờ. Mặc định tắt.
# (Quét riêng đơn của người đang xem luôn bật, không cần biến này.)
ORDER_JOBS_ENABLED=false
# Số kết nối tối đa backend giữ tới DB. Supabase (session pooler) chỉ có 15 chỗ dùng chung cả nhóm, nên để nhỏ.
DB_POOL_MAX=5
