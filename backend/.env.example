# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database (khớp với .env ở thư mục gốc dùng cho docker-compose)
DATABASE_URL=postgresql://weddy:change_me@localhost:5432/weddy_planner?schema=public

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Cloudinary (chưa dùng)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# VNPay (chưa dùng)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=
VNPAY_RETURN_URL=

# Mail (chưa dùng)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# LLM sinh timeline (chưa dùng)
LLM_API_KEY=
LLM_MODEL=
