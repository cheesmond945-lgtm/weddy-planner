# Địa chỉ backend (đã gồm tiền tố /api)
VITE_API_URL=http://localhost:3000/api
# true: dùng dữ liệu giả trong src/mocks và màn hình đăng nhập giả chọn role
VITE_USE_MOCK=true

# Nhóm API gọi backend thật (còn lại vẫn dùng dữ liệu giả khi VITE_USE_MOCK=true)
VITE_REAL_APIS=catalog,auth,vendors,favorites,compare,weddings,weddingsAi,chat,orders,vendorChat,commissions,googleRating

# Nút "Nhắn tin với NCC": internal = chat trong WebPlan (lưu hội thoại, báo cho NCC); zalo = mở Zalo của NCC, tin soạn sẵn được chép vào bộ nhớ tạm
VITE_CHAT_MODE=internal
